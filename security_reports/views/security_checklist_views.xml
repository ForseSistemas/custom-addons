<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- PLANTILLAS DE CHECKLIST (configuración del supervisor) -->
    <record id="view_security_checklist_template_tree" model="ir.ui.view">
        <field name="name">security.checklist.template.tree</field>
        <field name="model">security.checklist.template</field>
        <field name="arch" type="xml">
            <tree string="Plantillas de Checklist">
                <field name="name"/>
                <field name="tipo_trabajo"/>
            </tree>
        </field>
    </record>

    <record id="view_security_checklist_template_form" model="ir.ui.view">
        <field name="name">security.checklist.template.form</field>
        <field name="model">security.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Checklist">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <field name="name"/>
                        <field name="tipo_trabajo"/>
                    </group>
                    <separator string="Puntos del checklist"/>
                    <p class="text-muted">
                        Estos puntos se copian a cada reporte nuevo de este tipo de trabajo.
                        Los cambios no afectan a los reportes ya creados.
                    </p>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="obligatorio"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_security_checklist_template_search" model="ir.ui.view">
        <field name="name">security.checklist.template.search</field>
        <field name="model">security.checklist.template</field>
        <field name="arch" type="xml">
            <search string="Buscar Plantillas">
                <field name="name"/>
                <field name="tipo_trabajo"/>
                <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo de Trabajo" name="group_tipo"
                            context="{'group_by': 'tipo_trabajo'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_security_checklist_template" model="ir.actions.act_window">
        <field name="name">Plantillas de Checklist</field>
        <field name="res_model">security.checklist.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENÚ: Configuración (solo supervisores y administradores) -->
    <menuitem id="menu_security_config"
              name="Configuración"
              parent="menu_security_root"
              groups="security_reports.group_security_supervisor,base.group_system"
              sequence="90"/>

    <menuitem id="menu_security_checklist_template"
              name="Plantillas de Checklist"
              parent="menu_security_config"
              action="action_security_checklist_template"
              sequence="10"/>

</odoo>
