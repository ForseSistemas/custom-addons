<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sin noupdate: así las reglas se actualizan al actualizar el módulo -->

    <!-- Reportes: los técnicos solo ven y editan los suyos -->
    <record id="rule_security_report_tecnico" model="ir.rule">
        <field name="name">Técnicos: solo sus propios reportes</field>
        <field name="model_id" ref="model_security_report"/>
        <field name="domain_force">[('tecnico_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_security_tecnico'))]"/>
    </record>

    <!-- Reportes: los supervisores ven todos -->
    <record id="rule_security_report_supervisor" model="ir.rule">
        <field name="name">Supervisores: todos los reportes</field>
        <field name="model_id" ref="model_security_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_security_supervisor'))]"/>
    </record>

    <!-- Líneas de equipos: siguen la visibilidad del reporte -->
    <record id="rule_security_report_line_tecnico" model="ir.rule">
        <field name="name">Técnicos: líneas de sus propios reportes</field>
        <field name="model_id" ref="model_security_report_line"/>
        <field name="domain_force">[('report_id.tecnico_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_security_tecnico'))]"/>
    </record>

    <record id="rule_security_report_line_supervisor" model="ir.rule">
        <field name="name">Supervisores: todas las líneas</field>
        <field name="model_id" ref="model_security_report_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_security_supervisor'))]"/>
    </record>
</odoo>
