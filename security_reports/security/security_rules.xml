<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Regla: Los técnicos solo ven sus propios reportes -->
        <record id="rule_security_report_tecnico" model="ir.rule">
            <field name="name">Técnicos: solo sus propios reportes</field>
            <field name="model_id" ref="model_security_report"/>
            <field name="domain_force">[('tecnico_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_security_tecnico'))]"/>
        </record>

        <!-- Regla: Los supervisores ven todos los reportes -->
        <record id="rule_security_report_supervisor" model="ir.rule">
            <field name="name">Supervisores: todos los reportes</field>
            <field name="model_id" ref="model_security_report"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_security_supervisor'))]"/>
        </record>
    </data>
</odoo>