            <field name="obligatorio" eval="True"/>
        </record>
        <record id="checklist_template_desinstalacion_4" model="security.checklist.template.line">
            <field name="template_id" ref="checklist_template_desinstalacion"/>
            <field name="sequence">40</field>
            <field name="name">Área de trabajo limpia y sin residuos</field>
            <field name="obligatorio" eval="False"/>
