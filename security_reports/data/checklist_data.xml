        <record id="checklist_template_instalacion_6" model="security.checklist.template.line">
            <field name="template_id" ref="checklist_template_instalacion"/>
            <field name="sequence">60</field>
            <field name="name">Área de trabajo limpia y sin residuos</field>
            <field name="obligatorio" eval="False"/>
        </record>

        <record id="checklist_template_mantenimiento" model="security.checklist.template">
            <field name="name">Checklist de Mantenimiento</field>
            <field name="tipo_trabajo">mantenimiento</field>
