<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantillas iniciales: el supervisor puede editarlas desde Seguridad > Configuración -->
    <data noupdate="1">

        <record id="checklist_template_instalacion" model="security.checklist.template">
            <field name="name">Checklist de Instalación</field>
            <field name="tipo_trabajo">instalacion</field>
        </record>
        <record id="checklist_template_instalacion_1" model="security.checklist.template.line">
            <field name="template_id" ref="checklist_template_instalacion"/>
            <field name="sequence">10</field>
            <field name="name">Equipo instalado y fijado correctamente</field>
            <field name="obligatorio" eval="True"/>
        </record>
        <record id="checklist_template_instalacion_2" model="security.checklist.template.line">
            <field name="template_id" ref="checklist_template_instalacion"/>
            <field name="sequence">20</field>
            <field name="name">Cableado ordenado, canalizado y rotulado</field>
            <field name="obligatorio" eval="True"/>
        </record>
        <record id="checklist_template_instalacion_3" model="security.checklist.template.line">
            <field name="template_id" ref="checklist_template_instalacion"/>
            <field name="sequence">30</field>
            <field name="name">Imagen en vivo verificada en todas las cámaras</field>
            <field name="obligatorio" eval="True"/>
        </record>
        <record id="checklist_template_instalacion_4" model="security.checklist.template.line">
            <field name="template_id" ref="checklist_template_instalacion"/>
