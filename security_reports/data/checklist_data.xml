            <field name="name">Checklist de Diagnóstico</field>
            <field name="tipo_trabajo">diagnostico</field>
        </record>
        <record id="checklist_template_diagnostico_1" model="security.checklist.template.line">
            <field name="template_id" ref="checklist_template_diagnostico"/>
