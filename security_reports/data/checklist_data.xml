            <field name="name">Equipos y conexiones revisados</field>
            <field name="obligatorio" eval="True"/>
        </record>
        <record id="checklist_template_diagnostico_2" model="security.checklist.template.line">
            <field name="template_id" ref="checklist_template_diagnostico"/>
            <field name="sequence">20</field>
            <field name="name">Causa probable documentada</field>
            <field name="obligatorio" eval="True"/>
        </record>
        <record id="checklist_template_diagnostico_3" model="security.checklist.template.line">
            <field name="template_id" ref="checklist_template_diagnostico"/>
            <field name="sequence">30</field>
            <field name="name">Recomendación explicada al cliente</field>
            <field name="obligatorio" eval="False"/>
